<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>gamelib artwork organizer</title>
  <link rel="stylesheet" href="/static/app.css">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class="app-header">
    <div class="app-header__title">
      <h1>gamelib <span>artwork organizer</span> <span class="app-header__version">v{{.ToolVersion}}</span></h1>
    </div>
    <p class="app-header__scope">
      <span class="status-dot" aria-hidden="true"></span>
      Read-only &mdash; no changes are made to your libraries.
    </p>
    <p class="app-header__context" id="workspace-context">Workspace context loads once JavaScript runs; see the first-run setup section for the CLI equivalent.</p>
  </header>

  <div class="app-shell">
    <nav class="stage-rail" aria-label="Organizer">
      <button type="button" class="stage-rail__toggle" id="stage-rail-toggle" aria-expanded="true" aria-controls="stage-rail-list">
        <span aria-hidden="true">&#9776;</span> Browse
      </button>
      <ul class="stage-rail__list" id="stage-rail-list">
        <li><a href="#library" class="nav-primary" aria-current="page">Library</a></li>
        <li><a href="#profile-library" class="nav-primary">Profiles</a></li>
        <li><a href="#sources" class="nav-primary">Sources</a></li>
        <li class="nav-separator"><a href="#advanced">Source folders</a></li>
      </ul>
    </nav>

    <main id="main-content" class="stage-main" tabindex="-1">
      <div class="live-region" role="status" aria-live="polite" id="status-region"></div>
      <div class="live-region live-region--assertive" role="alert" aria-live="assertive" id="error-region"></div>

      <section id="library" aria-labelledby="library-heading" class="organizer-view">
        <header class="view-heading">
          <div>
            <h2 id="library-heading">Library</h2>
            <p id="library-summary">Loading platforms and artwork&hellip;</p>
          </div>
          <button type="button" id="library-refresh">Rescan artwork</button>
        </header>
        <div id="scan-progress" class="scan-progress" role="status" aria-live="polite" hidden></div>
        <noscript><p class="noscript-fallback">JavaScript is required for the visual organizer. All review tools remain available in Advanced, and the CLI remains fully supported.</p></noscript>
        <div id="onboarding" class="onboarding" hidden>
          <div>
            <h3>We found places that may contain game artwork</h3>
            <p>Choose the sources you want to browse. Nothing in these folders will be changed.</p>
          </div>
          <form id="detected-sources-form">
            <div id="detected-sources-list" class="source-picker"></div>
            <div class="button-row">
              <button type="submit">Add selected sources</button>
              <a href="#setup" class="button-link" data-advanced-target="setup">Add a folder manually</a>
            </div>
          </form>
        </div>
        <p id="library-grid-status" class="sr-only" role="status" aria-live="polite"></p>
        <div id="platform-grid" class="platform-grid"></div>
      </section>

      <section id="platform-detail" aria-labelledby="platform-detail-heading" class="organizer-view" hidden>
        <button type="button" class="back-button" id="platform-back">&larr; Library</button>
        <header class="view-heading">
          <div>
            <h2 id="platform-detail-heading" tabindex="-1">Platform</h2>
            <p id="platform-summary"></p>
          </div>
        </header>
        <div id="platform-assets" class="platform-assets" hidden></div>
        <form id="game-filters" class="organizer-toolbar">
          <label for="game-search">Find a game</label>
          <input id="game-search" type="search" placeholder="Search titles">
          <label for="game-coverage">Artwork</label>
          <select id="game-coverage">
            <option value="">All games</option>
            <option value="has-art">Has artwork</option>
            <option value="missing">Missing roles</option>
          </select>
          <label for="game-role">Role</label>
          <select id="game-role">
            <option value="">Any role</option>
          </select>
          <label for="game-source">Source</label>
          <select id="game-source">
            <option value="">Any source</option>
          </select>
          <label for="game-sort">Sort</label>
          <select id="game-sort">
            <option value="title">Title</option>
            <option value="coverage">Artwork coverage</option>
          </select>
        </form>
        <p id="game-grid-status" class="sr-only" role="status" aria-live="polite"></p>
        <div id="game-grid" class="game-grid"></div>
      </section>

      <section id="game-detail" aria-labelledby="game-detail-heading" class="organizer-view" hidden>
        <button type="button" class="back-button" id="game-back">&larr; Platform</button>
        <header class="game-header">
          <div>
            <p class="game-platform" id="game-platform"></p>
            <h2 id="game-detail-heading" tabindex="-1">Game</h2>
            <div id="game-identities" class="chip-row"></div>
          </div>
          <p id="game-profile-use" class="profile-use"></p>
        </header>
        <div id="missing-artwork" class="missing-panel"></div>
        <div id="asset-gallery" class="asset-gallery"></div>
      </section>

      <section id="profile-library" aria-labelledby="profile-library-heading" class="organizer-view" hidden>
        <header class="view-heading">
          <div>
            <h2 id="profile-library-heading">Profiles</h2>
            <p>A profile is one artwork set for one device. Build it here, then publish it to that device.</p>
          </div>
        </header>
        <form id="profile-create" class="profile-create">
          <label for="profile-new-name">New profile for a device</label>
          <div class="profile-create__row">
            <input type="text" id="profile-new-name" name="name" placeholder="ROG Ally" autocomplete="off" required>
            <button type="submit" class="button-primary">Create profile</button>
          </div>
          <p class="context-line">Pick artwork from any game's gallery to add it to a profile.</p>
        </form>
        <div id="profile-card-grid" class="profile-grid"></div>
      </section>

      <section id="sources" aria-labelledby="sources-heading" class="organizer-view" hidden>
        <header class="view-heading">
          <div>
            <h2 id="sources-heading">Sources</h2>
            <p>Detected libraries and local artwork folders available to this organizer.</p>
          </div>
          <button type="button" id="sources-detect">Detect again</button>
        </header>
        <div id="source-card-grid" class="source-grid"></div>
      </section>

      <details id="advanced" class="advanced-area">
        <summary>
          <span>Source folders</span>
          <small>Choose which local folders this library reads artwork from</small>
        </summary>
        <div class="advanced-content">
      <section id="setup" aria-labelledby="setup-heading" class="stage-section">
        <h2 id="setup-heading">First-run setup</h2>
        <p>Configure the host-local roots this dashboard reads and validates. Saving writes only your local active configuration file.</p>
        <p class="context-line">Active configuration file: <code id="setup-config-path">(loading&hellip;)</code></p>
        <noscript><p class="noscript-fallback">JavaScript is required to edit configuration from this page. Hand-edit the active configuration JSON file directly, or use <code>gamelib manifest verify</code>/<code>gamelib validate</code> from the command line, then restart <code>gamelib serve</code>.</p></noscript>

        <details open>
          <summary>Roots (id, kind, path, system)</summary>
          <div class="table-scroller" tabindex="0" role="region" aria-label="Configured roots editor table">
            <table id="setup-roots-table">
              <caption>Configured roots and their validation results</caption>
              <thead>
                <tr>
                  <th scope="col">ID</th>
                  <th scope="col">Kind</th>
                  <th scope="col">Path</th>
                  <th scope="col">System</th>
                  <th scope="col">Validation</th>
                  <th scope="col">Remove</th>
                </tr>
              </thead>
              <tbody id="setup-roots-body"></tbody>
            </table>
          </div>
          <div class="button-row">
            <button type="button" id="setup-add-root">Add root</button>
            <button type="button" id="setup-validate-roots">Validate roots</button>
          </div>
          <p id="setup-validation-status" role="status"></p>
        </details>

        <form id="setup-form">
          <fieldset>
            <legend>Global policy default</legend>
            <label for="setup-default-mode">Default retention mode</label>
            <select id="setup-default-mode" name="defaultMode" required>
              <option value="managed">managed</option>
              <option value="tracked-external">tracked-external</option>
              <option value="promote-on-approval">promote-on-approval</option>
              <option value="quarantined">quarantined</option>
            </select>
          </fieldset>
          <fieldset>
            <legend>Local-only write boundary</legend>
            <p>Saving this form writes only the host-local active configuration on this machine. It does not create, modify, or delete anything in a canonical catalog, a generated bundle, generated Decky output, the Playnite database, or a homelab/live frontend.</p>
          </fieldset>
          <button type="submit" id="setup-save">Save configuration</button>
          <p id="setup-status" role="status"></p>
        </form>
      </section>

        </div>
      </details>
    </main>
  </div>

  <dialog id="artwork-preview" class="preview-dialog" aria-label="Artwork preview">
    <button type="button" id="preview-close" class="dialog-close" aria-label="Close artwork preview">&times;</button>
    <figure></figure>
  </dialog>

  <dialog id="profile-picker" class="profile-picker" aria-labelledby="profile-picker-heading">
    <form method="dialog">
      <h2 id="profile-picker-heading">Choose this <span data-role>artwork</span> for a profile</h2>
      <label for="profile-picker-select">Profile</label>
      <select id="profile-picker-select"></select>
      <div class="button-row">
        <button value="save">Use this artwork</button>
        <button value="cancel" class="secondary-action">Cancel</button>
      </div>
    </form>
  </dialog>

  <footer class="app-footer">
    <p>Local organizer &middot; Read-only library access &middot; No telemetry</p>
  </footer>

  <script type="module" src="/static/js/main.js"></script>
</body>
</html>
