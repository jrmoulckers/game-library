* text=auto
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
# The shared Prettier configuration sets endOfLine: 'lf'. Without an explicit
# eol here, a Windows checkout under core.autocrlf=true materialises CRLF, and
# `prettier --check` then fails locally while passing on a Linux runner -- a gate
# whose verdict depends on the platform rather than on the file. These are also
# the extensions of the vendored config and the tooling manifests, which must
# match their upstream bytes for the lock to verify.
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
# The vendored TypeScript declarations are hashed in engineering-configs.lock.json
# byte-for-byte. Without this they check out CRLF on Windows and `configs:check`
# reports upstream drift on a file nobody touched.
*.ts text eol=lf
